{
  "appId": "app.codeply.crew",
  "appName": "Codeply",
  "webDir": "www",
  "backgroundColor": "#0c0c0c",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0c0c0c",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "backgroundColor": "#0c0c0c"
