# Copy this to .env (gitignored) and fill in your own values.
#
# These are OAuth app credentials for the "Connect Apps" integrations
# (Vercel/Supabase deploy tools, GitHub repo creation). The app works fine
# without any of them - you'll just see "not configured" if you try to
# connect that specific integration. Each is free to register:
#
#   Vercel:   vercel.com/dashboard -> Integrations Console -> New Integration (OAuth2)
#             redirect URI: http://localhost:53683/vercel-callback
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
# The integration's "URL Slug" from the Integrations Console (its live page is
# vercel.com/integrations/<slug>) - needed to start the install flow.
VERCEL_SLUG=

#   Supabase: supabase.com/dashboard/org/_/apps -> New OAuth App
#             redirect URI: http://localhost:53684/supabase-callback
SUPABASE_CLIENT_ID=
SUPABASE_CLIENT_SECRET=

#   GitHub:   github.com/settings/developers -> OAuth Apps -> New OAuth App
#             Authorization callback URL: http://localhost:53685/github-callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

#   Gmail / Slack (optional): Google Cloud "Desktop app" OAuth client / Slack app
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Where the phone web app is hosted (defaults to https://mobile.codeply.app)
CRAFT_MOBILE_URL=
