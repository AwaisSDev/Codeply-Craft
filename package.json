{
  "name": "codeply-craft",
  "version": "1.1.15",
  "description": "Codeply Craft - the Codeply AI coding agent as a desktop app",
  "author": "Awais Siddique",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/install-engine.js && node scripts/install-sqlite.js",
    "mobile:prepare": "node scripts/prepare-mobile.js",
    "android:add": "npm run mobile:prepare && npx cap add android",
    "android:sync": "npm run mobile:prepare && npx cap sync android",
    "android:build": "npm run android:sync && set \"JAVA_HOME=%CD%\\android\\jdk21\" && cd android && gradlew.bat assembleDebug --no-daemon && copy app\\build\\outputs\\apk\\debug\\app-debug.apk ..\\CodeplyCraft.apk",
    "android:open": "npx cap open android",
    "embed-secrets": "node scripts/embed-secrets.js",
    "dist": "node scripts/embed-secrets.js && electron-builder --win",
    "test:engine": "node scripts/engine-test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "electron": "^29.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@huggingface/transformers": "^3.8.1",
    "@ricky0123/vad-web": "^0.0.31",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "geist": "^1.7.2",
    "kokoro-js": "^1.2.1",
    "msedge-tts": "^2.0.9",
    "onnxruntime-web": "^1.30.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "build": {
    "appId": "app.codeply.craft",
    "productName": "Codeply Craft",
    "copyright": "Copyright © 2026 Codeply",
    "extraMetadata": {
      "author": "Codeply"
    },
    "files": [
      "**/*",
      "!android",
      "!mobile-app",
      "!node_modules/.cache",
      "!*.md",
      "!*.log",
      "!*.err.log",
      "!.claude",
      "!.mcp.json",
      "!dist",
      "!out",
      "!codeply-cli",
      "!.env",
      "!.env.*",
      "!scripts/engine-test.mjs",
      "!scripts/rewind-test.mjs",
      "!dev-app-update.yml",
      "!vercel.json"
    ],
    "extraResources": [
      {
        "from": "codeply-cli",
        "to": "codeply-cli",
        "filter": [
          "**/*",
          "!node_modules"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Codeply-Craft-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codeply Craft",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Codeply-Craft-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "AwaisSDev",
      "repo": "Codeply-Craft"
    },
    "dmg": {
      "artifactName": "Codeply-Craft-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ]
  }
}
